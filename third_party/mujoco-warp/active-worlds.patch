+def step_active(m: Model, d: Data, active: wp.array):
+  """Advance and solve selected worlds; physics setup still runs globally.
+
+  Frozen integration fields: qpos, qvel, act, time and qacc_warmstart.
+  Inputs (ctrl, applied forces, mocap) are caller-owned and must also be masked.
+  Derived state and global contact packing are not frozen.
+  """
+  if m.opt.integrator not in (IntegratorType.EULER, IntegratorType.IMPLICITFAST):
+    raise ValueError("Active stepping requires Euler or implicitfast")
+  if m.nhistory or m.opt.enableflags & EnableBit.SLEEP:
+    raise ValueError("Active stepping does not support history buffers or sleeping")
+  if m.callback.control or m.callback.act_dyn or m.callback.act_gain or m.callback.act_bias or m.callback.sensor or m.callback.passive or m.callback.contactfilter:
+    raise ValueError("Active stepping does not support callbacks")
+  if active.dtype != wp.bool or active.shape != (d.nworld,) or active.device != d.qpos.device:
+    raise ValueError("Active mask must be a device bool array with one entry per world")
+  forward(m, d, active=active)
+  if m.opt.integrator == IntegratorType.EULER:
+    euler(m, d, active)
+  else:
+    implicit(m, d, active)
